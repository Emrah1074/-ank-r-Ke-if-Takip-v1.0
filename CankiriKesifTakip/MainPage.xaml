<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CankiriKesifTakip.MainPage"
    Title="Görev Takip"
    BackgroundColor="#F1F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- ÜST BAŞLIK -->
            <Border BackgroundColor="#17365D"
                    StrokeThickness="0"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label Text="ÇANKIRI İL ÖZEL İDARESİ"
                           TextColor="#FFFFFF"
                           FontSize="13"
                           FontAttributes="Bold"/>

                    <Label Text="Plan Proje Yatırım ve İnşaat Müdürlüğü"
                           TextColor="#FFFFFF"
                           FontSize="17"
                           FontAttributes="Bold"/>

                    <Label Text="KEŞİF VE GÖREV TAKİP SİSTEMİ"
                           TextColor="#D5E5F5"
                           FontSize="12"/>

                    <Label Text="Yönetim Paneli"
                           TextColor="White"
                           FontSize="23"
                           FontAttributes="Bold"
                           Margin="0,15,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- YENİ GÖREV -->
            <Button Text="+ YENİ GÖREV EKLE"
                    BackgroundColor="#2476B9"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12"
                    Clicked="NewTaskClicked"/>

            <Button Text="📋 GÖREV KAYITLARINI GÖRÜNTÜLE"
                    BackgroundColor="#16834A"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12"
                    Clicked="TaskListClicked"/>

            <!-- İSTATİSTİKLER -->
            <Label Text="GENEL DURUM"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#17365D"/>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TOPLAM GÖREV" FontSize="12" TextColor="#64748B"/>
                        <Label x:Name="lblToplam" Text="0" FontSize="30" FontAttributes="Bold" TextColor="#17365D"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="DEVAM EDEN" FontSize="12" TextColor="#64748B"/>
                        <Label x:Name="lblDevamEden" Text="0" FontSize="30" FontAttributes="Bold" TextColor="#2476B9"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TAMAMLANAN" FontSize="12" TextColor="#64748B"/>
                        <Label x:Name="lblTamamlanan" Text="0" FontSize="30" FontAttributes="Bold" TextColor="#16834A"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="KABUL BEKLEYEN" FontSize="12" TextColor="#64748B"/>
                        <Label x:Name="lblKabulBekleyen" Text="0" FontSize="30" FontAttributes="Bold" TextColor="#D18A19"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- HIZLI ERİŞİM -->
            <Label Text="HIZLI ERİŞİM"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#17365D"/>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label Text="📁  Görev Kayıtları" FontSize="16" TextColor="#17365D">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="HizliGorevler_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView HeightRequest="1" Color="#E2E8F0"/>

                    <Label Text="📍  İlçe ve Görev Yerleri" FontSize="16" TextColor="#17365D">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="HizliIlceler_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView HeightRequest="1" Color="#E2E8F0"/>

                    <Label Text="👷  Teknik Personel" FontSize="16" TextColor="#17365D">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="HizliPersonel_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView HeightRequest="1" Color="#E2E8F0"/>

                    <Label Text="📊  Raporlar ve İstatistikler" FontSize="16" TextColor="#17365D">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="HizliRaporlar_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="Çankırı İl Özel İdaresi © 2026"
                   FontSize="11"
                   TextColor="#8492A6"
                   HorizontalOptions="Center"
                   Margin="0,10,0,15"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>